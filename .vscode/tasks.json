{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/server/MzansiWork.Api/MzansiWork.Api.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "mzansi-api",
        "pattern": {
          "regexp": "^___MZANSI_NEVER___$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Now listening on:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "mzansiwork",
        "showReuseMessage": false
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
